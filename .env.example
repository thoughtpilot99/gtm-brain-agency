# Copy to .env.local and fill in. Never commit real keys. Never put keys inside workspaces/.
ANTHROPIC_API_KEY=
# Default model for all reasoning. Change only if you want a different Claude model.
GTM_MODEL=claude-opus-5-5
# ColdIQ (recommended): one key for company + people search, enrichment, email find + verify and signals.
# Get it at coldiq.com. When set, it is used instead of Apollo/Hunter (ZeroBounce still verifies if set).
COLDIQ_API_KEY=
# Hiring signals through ColdIQ cost about 7.5 credits per company, so they are off unless you turn them on.
COLDIQ_HIRING_SIGNALS=false
APOLLO_API_KEY=
# Email finder + verifier (either or both)
HUNTER_API_KEY=
ZEROBOUNCE_API_KEY=
# Testing only: true makes every client use made-up sample companies. Leave false for real work.
GTM_DEMO_MODE=false
# HTTP MCP server for Grok Bot / remote agents (npm run mcp:http). Generated on first run if empty.
GTM_MCP_TOKEN=
GTM_MCP_PORT=8787
